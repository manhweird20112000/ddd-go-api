# Example values for local development only. Replace them in .env.
POSTGRES_PASSWORD=localdev123
DATABASE_URL=postgres://template:localdev123@localhost:5432/template?sslmode=disable
REDIS_URL=redis://localhost:6379/0
HTTP_ADDR=:8080
GRPC_ADDR=:9090
METRICS_ADDR=:9100
OTLP_ENDPOINT=localhost:4317
OTLP_INSECURE=true
SERVICE_NAME=go-template
JWT_PRIVATE_KEY_BASE64=
JWT_ISSUER=go-template
JWT_AUDIENCE=go-template-api
ENABLED_MODULES=identity,notification
EVENT_BUS=inproc
NATS_URL=nats://localhost:4222
IDENTITY_GRPC_ADDR=localhost:9090
SHUTDOWN_TIMEOUT=15s
READY_TIMEOUT=2s
